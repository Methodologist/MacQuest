# SpeedLevel - Alliance 1-60 zone plan (WoW Forever)
#
# Same format as horde.plan (see the keyword list there).  build_route.py --faction alliance fills
# each SEGMENT with every worthwhile Alliance quest whose giver is on that map and whose level fits.
#
# Races: Human Dwarf Gnome NightElf Skyborne (default: all Alliance)
# uiMaps: Elwynn 1429, Dun Morogh 1426, Teldrassil 1438, Darkshore 1439, Westfall 1436, Loch Modan 1432,
#         Redridge 1433, Duskwood 1431, Wetlands 1437, Stormwind 1453, Ironforge 1455, Darnassus 1457

# ===================================================================== HUMAN
SEGMENT Northshire Valley
  races Human
  map 1429
  levels 1 7
  entry 1
  start npc Deputy Willem
  region 38 20 60 50

SEGMENT Elwynn Forest
  races Human
  map 1429
  levels 3 12
  start npc Innkeeper Farley
  pre GOTO 42.1 65.9 "Run south to Goldshire"
  pre HEARTH "Innkeeper Farley"
  post TRAIN "Train new spells (Goldshire or Stormwind)"

SEGMENT Stormwind City
  races Human
  map 1453
  levels 8 14
  start npc Dungar Longdrink
  pre GOTO 32.0 50.0 "Run north-west up the road into Stormwind" map=1429
  pre FP "Dungar Longdrink"
  post TRAIN "Train new spells in Stormwind"

# ===================================================================== DWARF / GNOME
SEGMENT Coldridge Valley
  races Dwarf Gnome
  map 1426
  levels 1 7
  entry 1
  start npc Sten Stoutarm
  region 18 60 40 88

SEGMENT Dun Morogh
  races Dwarf Gnome
  map 1426
  levels 3 12
  start npc Innkeeper Belm
  pre GOTO 46.7 53.6 "Run north through the tunnel to Kharanos"
  pre HEARTH "Innkeeper Belm"
  post TRAIN "Train new spells (Kharanos or Ironforge)"

SEGMENT Ironforge
  races Dwarf Gnome
  map 1455
  levels 8 14
  start npc Gryth Thurden
  pre GOTO 53.5 35.0 "Run up the road into Ironforge" map=1426
  pre FP "Gryth Thurden"
  post TRAIN "Train new spells in Ironforge"

SEGMENT Loch Modan
  races Dwarf Gnome
  map 1432
  levels 9 18
  start npc Thorgrum Borrelson
  pre GOTO 84.0 51.0 "Leave Dun Morogh east through the North Gate tunnel into Loch Modan (Thelsamar)" map=1426
  pre FP "Thorgrum Borrelson"
  pre HEARTH "Innkeeper Hearthstove"

